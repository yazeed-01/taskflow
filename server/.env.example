# Copy to .env. DATABASE_URL is relative to server/prisma/.
DATABASE_URL="file:./dev.db"

# Required: signs login tokens. Use a long random string, e.g. openssl rand -hex 32
JWT_SECRET="change-me-to-a-long-random-string"

# Optional
# PORT=4000
# NODE_ENV=production           # turns introspection off, strips stack traces, masks internal errors
# CLIENT_DIR=../client/dist     # serve the built React app from this server (single origin)
# CORS_ORIGIN=https://app.example.com   # only if the client is hosted on a different origin
# TRUST_PROXY=true              # behind a reverse proxy, so rate limiting sees real client IPs
# MAX_QUERY_DEPTH=12
# MAX_QUERY_COMPLEXITY=10000
# RATE_LIMIT_PER_MIN=600        # per IP, whole endpoint
# LOGIN_MAX_FAILURES=5          # per email, per 15 minutes
